# 実行時の固有情報は .env または .env.local に置いてください。
# 既に export 済みの環境変数は、これらの値より優先されます。

OPENAI_API_KEY=sk-example

# Slack / CDP
CDP_HOST=127.0.0.1
CDP_PORT=9222
ADJUTANT_SLACK_SELF_USER_IDS=UTEST0001,WTEST0002
ADJUTANT_SLACK_WORKSPACE_HOSTS=TTEAM0001=workspace-alpha.slack.com,TTEAM0002=workspace-beta.slack.com

# Optional fallback
PLAY_SLACK_SEARCH_WORKSPACE_URL=https://workspace-alpha.slack.com
